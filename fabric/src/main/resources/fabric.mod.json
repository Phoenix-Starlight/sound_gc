{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "environment": "*",
  "license": "${license}",
  "icon": "${mod_icon}",
  "entrypoints": {
    "main": [
      "org.fury_phoenix.soundgc.fabric.ExampleModFabric"
    ],
    "client": [
      "org.fury_phoenix.soundgc.fabric.client.ExampleModFabricClient"
    ]
  },
  "mixins": [
    "sound_gc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.16.5",
    "java": ">=8",
    "architectury": ">=1.32.68",
    "fabric": "*"
  }
}
